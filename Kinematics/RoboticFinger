class RoboticFinger:
    """ Robotic Finger 
    L_L : 4-vector of link lengths (mm).
    Th_J : 4-vector of joint angles (rads).
    R_P : Dictionary of pulleys to radii. Pulley naming convention r<shaft#><pulley#>.
    """
    def __init__(self, link_lengths, joint_angles, pulley_radii):
        self.L_L = link_lengths
        self.Th_J = joint_angles
        self.R_P = pulley_radii
        return
    
