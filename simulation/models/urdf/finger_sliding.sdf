<?xml version="1.0"?>
<!-- finger.sdf — Surgeon Team, ME 472 Robot Design Studio 2026 -->

<sdf version="1.7">
<model name="finger">
  <pose>0 0 0 1.5708 3.1416 1.5708</pose>

  <!-- BASE: Holder Assembly  -->
  <link name="base">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <pose>-0 0 0 0 0 0</pose>
      <mass>0.050749</mass>
      <inertia>
        <ixx>1.49076e-05</ixx><iyy>1.15156e-05</iyy><izz>2.16758e-05</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>1.543e-09</iyz>
      </inertia>
    </inertial>
    <visual name="base_visual">
      <pose>0.003122 0.014595 0.008572 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/holder.gltf</uri>
      </mesh></geometry>
    </visual>
    <collision name="base_collision">
      <pose>0.003122 0.014595 0.008572 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/holder.gltf</uri>
      </mesh></geometry>
    </collision>
  </link>

  <link name="slider">
    <inertial>
      <mass>0.05</mass>
      <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
    </inertial>
  </link>
  
  <joint name="slider_x" type="prismatic">
    <parent>world</parent>
    <child>slider</child>
    <axis>
      <xyz>1 0 0</xyz>
      <limit><lower>-0.2</lower><upper>0.2</upper></limit>
    </axis>
  </joint>

  <joint name="base_weld" type="fixed">
    <parent>slider</parent>
    <child>base</child>
  </joint>

  <!-- MCP LINK: MCP Assembly  -->
  <link name="mcp_link">
    <pose>0 0 0.026 0 0 0</pose>
    <inertial>
      <pose>-0.028730 0.020786 0.002502 0 0 0</pose>
      <mass>0.028237</mass>
      <inertia>
        <ixx>5.06234e-06</ixx><iyy>5.12318e-06</iyy><izz>3.91014e-06</izz>
        <ixy>3.992e-08</ixy><ixz>3.67262e-07</ixz><iyz>-1.36882e-07</iyz>
      </inertia>
    </inertial>
    <visual name="mcp_visual">
      <pose>0 -0.001 0 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/mcp.gltf</uri>
      </mesh></geometry>
    </visual>
    <collision name="mcp_collision">
      <pose>0 -0.001 0 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/mcp.gltf</uri>
      </mesh></geometry>
    </collision>
  </link>

  <!-- Splay  -->
  <joint name="mcp_splay" type="revolute">
    <parent>base</parent>
    <child>mcp_link</child>
    <pose>0 0.00125 0 0 0 0</pose>
    <axis>
      <xyz>0 1 0</xyz>
      <limit><lower>-0.1745</lower><upper>0.1745</upper>...</limit>
      <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
    </axis>
  </joint>

  <!-- PROXIMAL PHALANX -->
  <link name="proximal">
    <pose>0 0 0.050 0 0 0</pose>
    <inertial>
      <pose>-0.038550 0.025769 0.013862 0 0 0</pose>
      <mass>0.045542</mass>
      <inertia>
        <ixx>1.28481e-05</ixx><iyy>1.60416e-05</iyy><izz>6.91020e-06</izz>
        <ixy>6.62582e-07</ixy><ixz>2.30143e-06</ixz><iyz>-1.98433e-06</iyz>
      </inertia>
    </inertial>
    <visual name="proximal_visual">
      <pose>0 0 0 -1.5708 0 -1.5708</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/proximal.gltf</uri>
      </mesh></geometry>
    </visual>
    <collision name="proximal_collision">
      <pose>0 0 0 -1.5708 0 -1.5708</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/proximal.gltf</uri>
      </mesh></geometry>
    </collision>
  </link>

  <!-- MCP Flexion  -->
  <joint name="mcp_flexion" type="revolute">
    <parent>mcp_link</parent>
    <child>proximal</child>
    <pose>0 0 0 0 0 1.5708</pose>
    <axis>
      <xyz>0 1 0</xyz>
      <limit><lower>0</lower><upper>1.5708</upper>...</limit>
      <dynamics><damping>0.001</damping><friction>0.0</friction></dynamics>
    </axis>
  </joint>

  <!-- MIDDLE PHALANX -->
  <link name="middle">
    <pose>0 0 0.094 0 0 0</pose>
    <inertial>
      <pose>-0.050089 0.025438 0.007742 0 0 0</pose>
      <mass>0.026372</mass>
      <inertia>
        <ixx>6.08686e-06</ixx><iyy>7.69849e-06</iyy><izz>2.72833e-06</izz>
        <ixy>2.0536e-08</ixy><ixz>1.07053e-06</ixz><iyz>-7.0415e-08</iyz>
      </inertia>
    </inertial>
    <visual name="middle_visual">
      <pose>0 0 0 0 1.5708 -1.5708</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/middle.gltf</uri>
      </mesh></geometry>
    </visual>
    <collision name="middle_collision">
      <pose>0 0 0 0 1.5708 -1.5708</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/middle.gltf</uri>
      </mesh></geometry>
    </collision>
  </link>

  <!-- PIP  -->
  <joint name="pip" type="revolute">
    <parent>proximal</parent>
    <child>middle</child>
    <pose>0 0 0 0 0 1.5708</pose>
    <axis>
    <xyz>0 1 0</xyz>
    <limit><lower>0</lower><upper>1.5708</upper>...</limit>
      <dynamics><damping>0.001</damping><friction>0.0</friction></dynamics>
    </axis>
  </joint>

  <!-- DISTAL PHALANX -->
  <link name="distal">
    <pose>-0.009836 0.003260 0.137314 0 0 0</pose>
    <inertial>
      <pose>-0.061503 0.025385 0.140879 0 0 0</pose>
      <mass>0.025822</mass>
      <inertia>
        <ixx>3.53219e-06</ixx><iyy>4.35001e-06</iyy><izz>1.49345e-06</izz>
        <ixy>2.4812e-08</ixy><ixz>6.49831e-07</ixz><iyz>-8.5033e-08</iyz>
      </inertia>
    </inertial>
    <visual name="distal_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/distal.gltf</uri>
      </mesh></geometry>
    </visual>
    <collision name="distal_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry><mesh>
        <uri>package://finger_assembly/meshes/distal.gltf</uri>
      </mesh></geometry>
    </collision>
  </link>

  <!-- DIP -->
  <joint name="dip" type="revolute">
    <parent>middle</parent>
    <child>distal</child>
    <pose>0.009836 -0.003260 -0.004314 0 0 1.5708</pose>
    <axis>
    <xyz>0 1 0</xyz>
    <limit><lower>0</lower><upper>1.5708</upper>...</limit>
      <dynamics><damping>0.001</damping><friction>0.0</friction></dynamics>
    </axis>
  </joint>

  <!-- Pencil -->
  <link name="pencil">
    <pose relative_to="distal">0.0112 0 0.016 -1.5708 0 0</pose> 
    <inertial>
      <mass>0.005</mass>
      <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
    </inertial> 
    <visual name="pencil_visual">
      <pose>0 0 0 -1.5708 0 0</pose> 
      <geometry>
        <mesh>
          <uri>package://finger_assembly/meshes/pencil.gltf</uri>
        </mesh>
      </geometry>
    </visual>
    <collision name="pencil_col">
      <pose>0 0 0.02 0 0 0</pose>
      <geometry><sphere><radius>0.0005</radius></sphere></geometry>
    </collision>
  </link>
  <joint name="pencil_weld" type="fixed">
    <parent>distal</parent>
    <child>pencil</child>
  </joint>

</model>
</sdf>
